<Window x:Class="EngineMonitoring.ScaleCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalibrasi Timbangan" Height="500" Width="650" 
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#60A5FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Reset Button Style -->
        <Style x:Key="ResetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F87171"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#0F0F23" CornerRadius="15" BorderThickness="2" BorderBrush="#3B82F6">

        <Grid>
            <!-- Custom Title Bar -->
            <Border Background="#1A1A2E" CornerRadius="15,15,0,0" Height="50" 
                    VerticalAlignment="Top" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="⚖️" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="KALIBRASI TIMBANGAN" FontWeight="Bold" FontSize="16" 
                                   Foreground="#C0C0C0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Content="✕" Style="{StaticResource CloseButtonStyle}" 
                            HorizontalAlignment="Right" Margin="0,0,10,0" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,50,0,0">
                <StackPanel Margin="25,20,25,25">

                    <!-- Calibration Buttons -->
                    <Border Background="#10000000" CornerRadius="10" Padding="20" Margin="0,0,0,15"
                            BorderBrush="#3B82F6" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="🎯 TOMBOL KALIBRASI" FontWeight="Bold" FontSize="14" 
                                       Foreground="#60A5FA" Margin="0,0,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button x:Name="ZeroButton" Content="🔄 Kalibrasi Nol" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Click="ZeroButton_Click" Margin="0,0,10,0" Grid.Column="0"/>
                                
                                <Button x:Name="CaptureButton" Content="📦 Kalibrasi Beban" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Click="CaptureButton_Click" Margin="5,0,5,0" Grid.Column="1"/>
                                
                                <Button x:Name="SaveButton" Content="💾 Simpan Kalibrasi" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Click="SaveButton_Click" Margin="10,0,0,0" Grid.Column="2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Live Data Display -->
                    <Border Background="#10000000" CornerRadius="10" Padding="20" Margin="0,0,0,15"
                            BorderBrush="#10B981" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="📊 DATA REAL-TIME" FontWeight="Bold" FontSize="14" 
                                       Foreground="#34D399" Margin="0,0,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nilai Mentah:" 
                                           Foreground="#E2E8F0" Margin="0,0,20,10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LatestRawText" Grid.Row="0" Grid.Column="1" Text="--" 
                                           FontWeight="Bold" FontSize="16" Foreground="#60A5FA" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Offset (tanpa beban):" 
                                           Foreground="#E2E8F0" Margin="0,0,20,10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OffsetText" Grid.Row="1" Grid.Column="1" Text="--" 
                                           FontWeight="Bold" FontSize="16" Foreground="#10B981" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Faktor Kalibrasi (raw/gram):" 
                                           Foreground="#E2E8F0" Margin="0,0,20,10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CalFactorText" Grid.Row="2" Grid.Column="1" Text="--" 
                                           FontWeight="Bold" FontSize="16" Foreground="#F59E0B" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Berat Terkalibrasi (gram):" 
                                           Foreground="#E2E8F0" Margin="0,0,20,10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CalibratedWeightText" Grid.Row="3" Grid.Column="1" Text="--" 
                                           FontWeight="Bold" FontSize="18" Foreground="#EC4899" Margin="0,0,0,10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Status Section -->
                    <Border Background="#10000000" CornerRadius="10" Padding="15" Margin="0,0,0,15"
                            BorderBrush="#F59E0B" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="📢 STATUS" FontWeight="Bold" FontSize="14" 
                                       Foreground="#FBBF24" Margin="0,0,0,10"/>
                            <TextBlock x:Name="StatusText" Text="Siap untuk kalibrasi" 
                                       TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- Reset Button -->
                    <Button x:Name="ResetButton" Content="🔄 Reset Kalibrasi" 
                            Style="{StaticResource ResetButtonStyle}" 
                            Click="ResetButton_Click" HorizontalAlignment="Right" Width="200"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
