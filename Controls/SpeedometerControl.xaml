<UserControl x:Class="EngineMonitoring.Controls.SpeedometerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="240" Height="240">
    <Viewbox>
        <Canvas Width="240" Height="240">
            <!-- Outer Ring/Border -->
            <Ellipse Width="230" Height="230" Canvas.Left="5" Canvas.Top="5"
                     Fill="Transparent" Stroke="#2A2A2A" StrokeThickness="8"/>
            
            <!-- Inner Background Circle with gradient -->
            <Ellipse Width="210" Height="210" Canvas.Left="15" Canvas.Top="15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#1E293B" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <!-- Decorative Inner Ring -->
            <Ellipse Width="190" Height="190" Canvas.Left="25" Canvas.Top="25"
                     Fill="Transparent" Stroke="#334155" StrokeThickness="1" Opacity="0.5"/>
            
            <!-- Scale Marks -->
            <Canvas x:Name="ScaleCanvas"/>
            
            <!-- Needle Shadow (for depth) -->
            <Line x:Name="NeedleShadow" X1="120" Y1="120" X2="120" Y2="55"
                  Stroke="#000000" StrokeThickness="4" StrokeEndLineCap="Round" Opacity="0.3">
                <Line.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="NeedleShadowRotate" CenterX="120" CenterY="120" Angle="-135"/>
                        <TranslateTransform X="2" Y="2"/>
                    </TransformGroup>
                </Line.RenderTransform>
            </Line>
            
            <!-- Main Needle with gradient -->
            <Line x:Name="Needle" X1="120" Y1="120" X2="120" Y2="50"
                  StrokeThickness="3.5" StrokeEndLineCap="Round">
                <Line.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E3A8A" Offset="0"/>
                        <GradientStop Color="#3B82F6" Offset="1"/>
                    </LinearGradientBrush>
                </Line.Stroke>
                <Line.RenderTransform>
                    <RotateTransform x:Name="NeedleRotate" CenterX="120" CenterY="120" Angle="-135"/>
                </Line.RenderTransform>
            </Line>
            
            <!-- Center Hub (larger, more prominent) -->
            <Ellipse Width="20" Height="20" Canvas.Left="110" Canvas.Top="110">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1E3A8A" Offset="0.3"/>
                        <GradientStop Color="#172554" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <!-- Center Dot (glossy effect) -->
            <Ellipse Width="8" Height="8" Canvas.Left="116" Canvas.Top="116"
                     Fill="#60A5FA"/>
            
            <!-- Value Display Box with better styling -->
            <Border Canvas.Left="75" Canvas.Top="135" Width="90" Height="60"
                    Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="GAUGE" FontSize="9" FontWeight="SemiBold"
                               Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,4"
                               TextOptions.TextFormattingMode="Display"/>
                    <TextBlock x:Name="ValueText" Text="0.00" FontSize="24" FontWeight="Bold"
                               Foreground="#F1F5F9" HorizontalAlignment="Center"
                               TextOptions.TextFormattingMode="Display"/>
                    <TextBlock x:Name="UnitText" Text="unit" FontSize="9" FontWeight="Medium"
                               Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"
                               TextOptions.TextFormattingMode="Display"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Viewbox>
</UserControl>